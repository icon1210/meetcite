# MeetCite website on shared (Apache) hosting: static files only - the API runs elsewhere.

# The parent folder may run another app (e.g. a Node.js site) through Passenger; keep it out of here.
<IfModule mod_passenger.c>
  PassengerEnabled off
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Always use HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Real files (scripts, styles, icons) are served as they are...
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  # ...and every other address (/login, /meetings/5) loads the app, which shows the right page.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(self), display-capture=(self)"
  # Built files have content hashes in their names, so they can be cached for a long time.
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

Options -Indexes
