# Copy this file to .env and fill in the values. Never commit .env to Git.

# Long random strings. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# Hugging Face token for speaker identification (pyannote). Free:
#  1. Create an account at https://huggingface.co
#  2. Accept the terms at https://huggingface.co/pyannote/speaker-diarization-3.1
#     and https://huggingface.co/pyannote/segmentation-3.0
#  3. Create a "Read" token at https://huggingface.co/settings/tokens
HF_TOKEN=

# AI settings (defaults suit a 6 GB GPU such as an RTX 2060).
WHISPER_MODEL=large-v3
WHISPER_COMPUTE_TYPE=int8_float16
OLLAMA_MODEL=llama3.1:8b
DEFAULT_SUMMARIZER=llm
# After fine-tuning (research/finetune_bart_ami.py), point this at the checkpoint in ./models:
BART_MODEL=facebook/bart-large-cnn

# "fake" uses sample output instead of real AI - only for trying the interface without a GPU.
AI_MODE=real

# Optional cloud comparison (E3). Only ever use with public dataset meetings (spec §19).
CLOUD_LLM_ENABLED=false
ANTHROPIC_API_KEY=
