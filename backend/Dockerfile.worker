# GPU worker image: PyTorch + CUDA 12 + cuDNN 9 (what faster-whisper/CTranslate2 4.5 needs).
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt requirements-ml.txt ./
# torch is already in the base image; install the rest.
RUN pip install --no-cache-dir -r requirements-ml.txt torchaudio==2.5.1

COPY . .

# Model downloads (Whisper, pyannote, BART) are cached in a volume so they survive rebuilds.
ENV HF_HOME=/models/huggingface
CMD ["celery", "-A", "app.worker.celery_app", "worker", "--concurrency=1", "--loglevel=info"]
