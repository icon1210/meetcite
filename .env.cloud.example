# MeetMind cloud mode - copy to .env on the server and fill in. Never commit .env to Git.

# The address people will use, pointed at this server's IP in your DNS (no https://).
DOMAIN=meetmind.example.com

# A long random string. Generate one with:  openssl rand -base64 48
SECRET_KEY=

# Sign-up code: only people you give it to can create an account, so strangers can't use
# your AI credits. Pick any word or phrase. Leave empty to let anyone sign up.
REGISTRATION_CODE=

# Speech-to-text and speaker separation: https://www.assemblyai.com (Dashboard -> API keys)
ASSEMBLYAI_API_KEY=
# For processing in the EU instead of the US:
# ASSEMBLYAI_BASE_URL=https://api.eu.assemblyai.com

# Minutes and evidence checks: https://console.anthropic.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# Thinking depth: low (fastest) | medium | high
CLOUD_LLM_EFFORT=low
